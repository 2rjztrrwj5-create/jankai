<header class="border-bottom py-2" style="background-color: #E8F5E0;">
  <div class="container position-relative d-flex justify-content-end">
    <div class="container d-flex justify-content-between align-items-center">
      <%= link_to "雀会", root_path, class: "fw-bold text-decoration-none", style: "color: #2D6A4F; font-size: 6rem; font-family: 'Yuji Syuku', serif;" %>
    </div>
    <nav class="d-flex gap-2 align-items-center">
      <% if authenticated? %>
        <%= link_to "マイページ", mypage_path, class: "btn btn-success text-nowrap" %>
        <%= link_to "新しい募集", new_post_path, class: "btn btn-primary text-nowrap" %>
        <%= link_to "みんなの募集", posts_path, class: "btn btn-primary text-nowrap" %>
        <%= link_to "所属グループ", groups_path, class: "btn btn-primary text-nowrap" %>
        <%= button_to "ログアウト", session_path, method: :delete, class: "btn btn-danger text-nowrap" %>
      <% else %>
        <%= link_to "新規登録", signup_path, class: "btn btn-secondary text-nowrap" %>
        <%= link_to "ログイン", login_path, class: "btn btn-success text-nowrap" %>
      <% end %>
    </nav>
    <% if authenticated? %>
      <div class="container d-flex justify-content-end align-items-center position-absolute top-0 end-0"style="margin-top: 6.5rem;">
        <%= form_with url: search_path, method: :get, local: true, class: "d-flex" do |f| %>
          <div class="ms-2">
            <%= f.text_field :keyword, placeholder: "検索", class: "form-control" %>
          </div>
          <div class="ms-2">
            <%= f.submit "検索", class: "btn btn-outline-primary" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</header>