<header class="container position-relative d-flex justify-content-end align-items-center p-3">
  <div class="position-absolute start-50 translate-middle-x">
    <%= link_to "雀会", root_path, class: "fw-bold fs-1 text-decoration-none text-dark" %>
  </div>
  <nav>
    <% if authenticated? %>
      <%= button_to "ログアウト", session_path, method: :delete, class: "btn btn-danger" %>
    <% else %>
      <%= link_to "新規登録", signup_path, class: "btn btn-secondary" %>
      <%= link_to "ログイン", login_path, class: "btn btn-success" %>
    <% end %>
  </nav>
</header>