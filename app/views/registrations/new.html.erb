<%= form_with model: @user, url: signup_path do |f| %>
  <%= f.label :name %>
  <%= f.text_field :name %>
  <%= f.label :email_address %>
  <%= f.email_field :email_address %>
  <%= f.label :password %>
  <%= f.password_field :password %>
  <%= f.label :password_confirmation %>
  <%= f.password_field :password_confirmation %>
  <%= f.submit "新規登録" %>
<% end %>