<div class="container">
  <div class="d-flex gap-2 mb-3">
    <%= link_to "ユーザー管理", admin_users_path, class: "btn btn-outline-primary" %>
    <%= link_to "コメント管理", admin_comments_path, class: "btn btn-outline-primary" %>
  </div>
  <h2 class="bg-body-secondary rounded-0 px-3 py-2 mt-3 mb-4 d-inline-block fs-4">グループ一覧</h2>
  <ul class="list-group">
    <% @groups.each do |group| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <%= group.name %>
        <%= button_to "削除", admin_group_path(group), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-danger" %>
      </li>
    <% end %>
  </ul>
</div>