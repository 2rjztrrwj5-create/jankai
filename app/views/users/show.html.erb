<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-2 mt-3 mb-4 d-inline-block fs-4">ユーザー詳細</h2>
  <table class="table table-bordered mt-3">
    <tbody>
      <tr>
        <th class="bg-light">ユーザー名</th>
        <td><%= @user.name %></td>
      </tr>
      <tr>
        <th class="bg-light">コメント数</th>
        <td><%= @user.comments.count %></td>
      </tr>
    </tbody>
  </table>
  <h3 class="mt-4">投稿一覧</h3>
  <ul class="list-group">
    <% @user.posts.each do |post| %>
      <li class="list-group-item">
        <%= link_to post.title, post_path(post) %>
      </li>
    <% end %>
  </ul>
  <%= link_to "検索結果に戻る", search_path, class: "btn btn-secondary" %>
</div>