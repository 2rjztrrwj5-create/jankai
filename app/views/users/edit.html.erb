<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-2 mt-3 mb-4 d-inline-block fs-4">ユーザー編集</h2>
  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <% @user.errors.full_messages.each do |message| %>
        <p class="mb-0"><%= message %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with model: @user, url: users_edit_path do |f| %>
    <div class="mb-3">
      <%= f.label :name, "ユーザー名", class: "form-label fw-bold" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= f.label :email_address, "メールアドレス", class: "form-label fw-bold" %>
      <%= f.email_field :email_address, class: "form-control" %>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <%= f.submit "更新", class: "btn btn-primary btn-lg" %>
      <%= link_to "マイページに戻る", mypage_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
  <div class="text-end mt-2">
    <%= button_to "退会", users_path, method: :delete, data: { turbo_confirm: "本当に退会しますか？" }, class: "btn btn-danger" %>
  </div>
</div>