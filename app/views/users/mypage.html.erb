<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-4 d-inline-block fs-4">マイページ</h2>
  <div class="row">
    <div class="col-md-6">
      <table class="table table-bordered">
        <tbody>
          <tr>
            <th class="bg-light">ユーザー名</th>
            <td><%= @user.name %></td>
          </tr>
          <tr>
            <th class="bg-light">メールアドレス</th>
            <td><%= @user.email_address %></td>
          </tr>
        </tbody>
      </table>
      <%= link_to "編集", users_edit_path, class: "btn btn-primary" %>
    </div>
  </div>
  <div class="row">
    <div class="col-md-4">
      <h3>投稿一覧</h3>
      <ul class="list-group">
        <% @posts.each do |post| %>
          <li class="list-group-item">
            <%= link_to post.title, post_path(post) %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>