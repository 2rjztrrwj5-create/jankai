<div class="container d-flex align-items-center justify-content-center" style="min-height: 70vh;">
  <div class="row justify-content-center w-100">
    <div class="col-md-6">
      <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-4 d-inline-block fs-4">ログイン</h2>
      <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
      <%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>
      <%= form_with url: session_path do |form| %>
        <div class="mb-3">
          <%= form.label :email_address, "メールアドレス", class: "form-label fw-bold" %>
          <%= form.email_field :email_address, class: "form-control", required: true, autofocus: true, autocomplete: "username", placeholder: "メールアドレスを入力してください", value: params[:email_address] %>
        </div>
        <div class="mb-3">
          <%= form.label :password, "パスワード", class: "form-label fw-bold" %>
          <%= form.password_field :password, class: "form-control", required: true, autocomplete: "current-password", placeholder: "パスワードを入力してください", maxlength: 72 %>
        </div>
        <%= form.submit "ログイン", class: "btn btn-primary w-100" %>
      <% end %>
    </div>
  </div>
</div>
<br>

<%= link_to "パスワードを忘れた場合", new_password_path %>
