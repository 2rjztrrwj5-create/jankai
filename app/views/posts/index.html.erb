<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-2 mt-3 mb-4 d-inline-block fs-4">投稿一覧</h2>
  <%= link_to "新規投稿", new_post_path %>
  <ul class="list-group">
    <% @posts.each do |post| %>
      <li class="list-group-item">
        <%= link_to post.title, post_path(post) %>
        <span class="text-muted">
          (<%= post.prefecture %> / <%= post.event_at.strftime("%Y年%m月%d日 %H:%M") %>)</span>
      </li>
    <% end %>
  </ul>
</div>