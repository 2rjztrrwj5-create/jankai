<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-2 mt-3 mb-4 d-inline-block fs-4">募集の詳細</h2>

  <table class="table table-bordered mt-3">
    <tbody>
      <tr>
        <th class="bg-light">タイトル</th>
        <td><%= @post.title %></td>
      </tr>
      <tr>
        <th class="bg-light">募集内容</th>
        <td><%= @post.body %></td>
      </tr>
      <tr>
        <th class="bg-light">開催日時</th>
        <td><%= @post.event_at.strftime("%Y年%m月%d日 %H:%M") %></td>
      </tr>
      <tr>
        <th class="bg-light">募集人数</th>
        <td><%= @post.capacity %></td>
      </tr>
      <tr>
        <th class="bg-light">形式</th>
        <td><%= @post.format == "offline" ? "対面" : "オンライン" %></td>
      </tr>
      <tr>
        <th class="bg-light">開催場所</th>
        <td><%= @post.prefecture %></td>
      </tr>
      <tr>
        <th class="bg-light">投稿者</th>
        <td><%= @post.user.name %></td>
      </tr>
    </tbody>
  </table>

  <% if @post.user == Current.user %>
    <div class="d-flex gap-2 align-items-center mt-3">
      <%= link_to "編集", edit_post_path(@post), class: "btn btn-primary btn-lg" %>
      <%= button_to "削除", post_path(@post), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-lg" %>
      <%= link_to "一覧に戻る", posts_path, class: "btn btn-secondary" %>
    </div>
  <% end %>

  <% if @post.group %>
    <p class="text-success mt-3">グループが、作成されました！</p>
  <% end %>

  <% if @post.user == Current.user %>
    <h3 class="mt-4">参加申請一覧</h3>
    <ul class="list-group">
      <% @post.applications.pending.each do |application| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= application.user.name %>
          <div class="d-flex gap-2">
            <%= button_to "承認", approve_post_path(@post, user_id: application.user_id), method: :patch, class: "btn btn-sm btn-success", data: { turbo: false } %>
            <%= button_to "却下", reject_post_path(@post, user_id: application.user_id), method: :patch, class: "btn btn-sm btn-danger", data: { turbo: false } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% elsif @post.applications.exists?(user: Current.user) %>
    <p class="text-muted mt-3">参加申請済みです。</p>
  <% else %>
    <%= button_to "参加申請する", post_applications_path(@post), class: "btn btn-primary mt-3", data: { turbo: false } %>
  <% end %>

  <h3 class="mt-5">コメント</h3>
  <%= form_with model: [@post, Comment.new], url: post_comments_path(@post) do |f| %>
    <div class="mb-3">
      <%= f.text_area :body, class: "form-control", placeholder: "コメントを入力" %>
    </div>
    <%= f.submit "コメントする", class: "btn btn-primary" %>
  <% end %>

  <ul class="list-group mt-3">
    <% @post.comments.each do |comment| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <strong><%= comment.user.name %></strong>: <%= comment.body %>
        </div>
        <% if comment.user == Current.user %>
          <%= button_to "削除", comment_path(comment), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-danger" %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>