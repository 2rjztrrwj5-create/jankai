<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-2 mt-3 mb-4 d-inline-block fs-4">検索結果</h2>

  <%= form_with url: search_path, method: :get, local: true do |f| %>
    <%= f.text_field :keyword, placeholder: "キーワードで検索", value: @keyword, class: "form-control" %>
    <%= f.submit "検索", class: "btn btn-primary mt-2" %>
  <% end %>

  <div class="row mt-5">
    <div class="col-md-6">
      <h3>投稿</h3>
      <ul class="list-group">
        <% @posts.each do |post| %>
          <li class="list-group-item">
            <%= link_to post.title, post_path(post) %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="col-md-6">
      <h3>ユーザー</h3>
      <ul class="list-group">
        <% @users.each do |user| %>
          <li class="list-group-item">
            <%= link_to user.name, user_path(user) %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>