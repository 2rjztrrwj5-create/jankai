<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-2 mt-3 mb-4 d-inline-block fs-4">参加グループ一覧</h2>
  <ul class="list-group">
    <% @groups.each do |group| %>
      <li class="list-group-item">
        <%= link_to group.name, group_path(group) %>
      </li>
    <% end %>
  </ul>
</div>