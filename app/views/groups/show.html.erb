<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-2 mt-3 mb-4 d-inline-block fs-4"><%= @group.name %></h2>

  <h3 class="mt-4">メンバー一覧</h3>
  <ul class="list-group">
    <% @group.users.each do |user| %>
      <li class="list-group-item"><%= user.name %></li>
    <% end %>
  </ul>

  <%= link_to "一覧に戻る", groups_path, class: "btn btn-secondary mt-3" %>
</div>