<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-2 mt-3 mb-4 d-inline-block fs-4">新規グループ作成</h2>
  <%= form_with model: @group do |f| %>
    <div class="mb-3">
      <%= f.label :name, "グループ名", class: "form-label fw-bold" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= f.label :description, "説明・ルール", class: "form-label fw-bold" %>
      <%= f.text_area :description, class: "form-control" %>
    </div>
    <%= f.submit "作成", class: "btn btn-primary" %>
  <% end %>
</div>